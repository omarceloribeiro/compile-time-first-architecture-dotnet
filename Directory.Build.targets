<Project>
  <!-- Composition roots that opt in to the dependency-injection build gate also compile the
       shared validator. Linking it here keeps every project free of a relative path whose
       correctness depends on how deeply the project is nested. -->
  <ItemGroup Condition="'$(ValidateDependencyInjectionOnBuild)' == 'true'">
    <Compile Include="$(RepoRoot)eng/DependencyInjectionGraphValidator.cs"
             Link="Validation/DependencyInjectionGraphValidator.cs" />
  </ItemGroup>

  <Target
    Name="RunDependencyInjectionValidation"
    AfterTargets="Build"
    Condition="
      '$(ValidateDependencyInjectionOnBuild)' == 'true'
      and '$(SkipDependencyInjectionValidation)' != 'true'
      and '$(DesignTimeBuild)' != 'true'
      and '$(IsCrossTargetingBuild)' != 'true'
      and '$(TargetPath)' != ''
      and Exists('$(TargetPath)')">
    <Message Importance="high" Text="Validating dependency injection for $(MSBuildProjectName)..." />
    <Exec WorkingDirectory="$(TargetDir)" Command="dotnet &quot;$(TargetPath)&quot; --validate-di" />
  </Target>
</Project>
