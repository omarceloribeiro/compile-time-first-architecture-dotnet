@page "/auto-subjects"
@rendermode InteractiveAuto
@inject AutoSubjectsViewModel ViewModel

<PageTitle>Interactive Auto OData</PageTitle>

<h1>Interactive Auto/OData</h1>

<div class="alert alert-info">
    Active provider: <strong>@ViewModel.ProviderName</strong>
</div>

@if (ViewModel.ErrorMessage is not null)
{
    <div class="alert alert-danger">@ViewModel.ErrorMessage</div>
}
else if (ViewModel.Items.Count == 0)
{
    <p class="text-muted">No active subjects found.</p>
}
else
{
    <ul class="list-group">
        @foreach (var subject in ViewModel.Items)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@subject.Name</span>
                <small class="text-muted">@subject.Id</small>
            </li>
        }
    </ul>

    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Subjects pages">
        <button class="btn btn-outline-secondary" disabled="@(!ViewModel.HasPreviousPage)"
                @onclick="LoadPreviousPageAsync">
            Previous
        </button>
        <span>Page @(ViewModel.CurrentPage + 1) of @ViewModel.TotalPages (@ViewModel.TotalCount items)</span>
        <button class="btn btn-outline-secondary" disabled="@(!ViewModel.HasNextPage)"
                @onclick="LoadNextPageAsync">
            Next
        </button>
    </nav>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync();
    }

    private Task LoadPreviousPageAsync() => ViewModel.LoadAsync(ViewModel.CurrentPage - 1);

    private Task LoadNextPageAsync() => ViewModel.LoadAsync(ViewModel.CurrentPage + 1);
}
