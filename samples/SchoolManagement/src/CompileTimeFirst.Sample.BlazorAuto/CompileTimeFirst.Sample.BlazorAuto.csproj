<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="../CompileTimeFirst.Sample.Data/CompileTimeFirst.Sample.Data.csproj" />
    <ProjectReference Include="../CompileTimeFirst.Sample.BlazorAuto.Client/CompileTimeFirst.Sample.BlazorAuto.Client.csproj" />
    <ProjectReference Include="../CompileTimeFirst.Sample.Analyzers/CompileTimeFirst.Sample.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ValidateDependencyInjectionOnBuild>true</ValidateDependencyInjectionOnBuild>
  </PropertyGroup>

</Project>
