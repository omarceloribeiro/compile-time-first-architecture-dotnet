@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span>Compile-Time First School</span>
            <AuthorizeView>
                <Authorized Context="authenticationState">
                    <div class="d-flex align-items-center gap-3">
                        <span>@authenticationState.User.Identity?.Name</span>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @* Routes adopts global Interactive Server, so this layout and its boundary share the
               same interactive tree as every supported page. Expected application rejections are
               still handled by the screen; unexpected component failures are logged and rendered
               generically here. *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">Something went wrong</h5>
                        <p>The operation could not be completed. The error has been logged.</p>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="Recover">
                            Try again
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    protected override void OnInitialized() =>
        Navigation.LocationChanged += HandleLocationChanged;

    private void Recover() => errorBoundary?.Recover();

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(Recover);

    public void Dispose() =>
        Navigation.LocationChanged -= HandleLocationChanged;
}
