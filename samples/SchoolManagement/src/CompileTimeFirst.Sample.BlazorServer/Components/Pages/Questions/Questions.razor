@page "/questions"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using CompileTimeFirst.Sample.Application
@using CompileTimeFirst.Sample.Application.Questions
@using CompileTimeFirst.Sample.ReadModel
@inject IReadSchoolDbFactory ReadDbFactory
@inject IReadQueryExecutor QueryExecutor
@inject ICreateQuestionUseCase CreateQuestion

<PageTitle>Create Question</PageTitle>

<h1>Create Question</h1>

@if (successMessage is not null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card">
    <div class="card-body">
        <EditForm Model="form" OnValidSubmit="HandleCreateAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label for="statement" class="form-label">Statement</label>
                <InputTextArea id="statement" class="form-control" rows="5"
                               @bind-Value="form.Statement" disabled="@isBusy" />
                <ValidationMessage For="@(() => form.Statement)" />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="subject" class="form-label">Subject</label>
                    <InputSelect id="subject" class="form-select" @bind-Value="form.SubjectId" disabled="@isBusy">
                        <option value="">Select a subject</option>
                        @foreach (var subject in subjects)
                        {
                            <option value="@subject.Id">@subject.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.SubjectId)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="grade" class="form-label">Grade</label>
                    <InputSelect id="grade" class="form-select" @bind-Value="form.GradeId" disabled="@isBusy">
                        <option value="">Select a grade</option>
                        @foreach (var grade in grades)
                        {
                            <option value="@grade.Id">@grade.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.GradeId)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="questionType" class="form-label">Type</label>
                    <InputSelect id="questionType" class="form-select" @bind-Value="form.Type"
                                 @bind-Value:after="ApplyTypeDefaults" disabled="@isBusy">
                        @foreach (var type in Enum.GetValues<QuestionType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>
            </div>

            @if (UsesOptions)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Options</h5>
                    @if (AllowsCustomOptions)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="AddOption" disabled="@isBusy">
                            Add option
                        </button>
                    }
                </div>

                @foreach (var option in form.Options)
                {
                    <div class="input-group mb-2">
                        <span class="input-group-text">@option.Order</span>
                        <InputText class="form-control" @bind-Value="option.Text"
                                   disabled="@(isBusy || form.Type == QuestionType.TrueOrFalse)" />
                        <span class="input-group-text">
                            @if (form.Type == QuestionType.MultipleChoice)
                            {
                                <InputCheckbox class="form-check-input mt-0 me-2" @bind-Value="option.IsCorrect"
                                               disabled="@isBusy" />
                            }
                            else
                            {
                                <input class="form-check-input mt-0 me-2" type="radio" name="correctOption"
                                       checked="@option.IsCorrect" @onchange="@(() => MarkSingleCorrect(option))"
                                       disabled="@isBusy" />
                            }
                            Correct
                        </span>
                        @if (AllowsCustomOptions)
                        {
                            <button type="button" class="btn btn-outline-danger"
                                    @onclick="@(() => RemoveOption(option))"
                                    disabled="@(isBusy || form.Options.Count <= QuestionShape.MinObjectiveOptions)">
                                Remove
                            </button>
                        }
                    </div>
                }
            }

            <button type="submit" class="btn btn-primary mt-3" disabled="@isBusy">
                @if (isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Create question
            </button>
        </EditForm>
    </div>
</div>

@code {
    private IReadOnlyList<SelectOption> subjects = [];
    private IReadOnlyList<SelectOption> grades = [];
    private QuestionForm form = new();
    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;

    // The editor shape comes from the application layer, so this screen stays a projection of a
    // rule it does not own.
    private bool UsesOptions => QuestionShape.UsesOptions(form.Type);
    private bool AllowsCustomOptions => QuestionShape.AllowsCustomOptions(form.Type);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await ReadDbFactory.CreateAsync();

        subjects = await QueryExecutor.ToListAsync(
            db.Subjects
                .Where(x => x.IsActive)
                .OrderBy(x => x.Name)
                .Select(x => new SelectOption(x.Id, x.Name)));

        grades = await QueryExecutor.ToListAsync(
            db.Grades
                .Where(x => x.IsActive)
                .OrderBy(x => x.Order)
                .Select(x => new SelectOption(x.Id, x.Name)));

        ApplyTypeDefaults();
    }

    private void ApplyTypeDefaults()
    {
        errorMessage = null;
        form.Options = [.. QuestionShape.DefaultOptions(form.Type)
            .Select(draft => new OptionEditor(draft.Text, draft.IsCorrect, draft.Order))];
    }

    private void AddOption()
    {
        if (!AllowsCustomOptions || form.Options.Count >= QuestionShape.MaxOptions)
        {
            return;
        }

        form.Options.Add(new OptionEditor(string.Empty, false, form.Options.Count + 1));
    }

    private void RemoveOption(OptionEditor option)
    {
        if (!AllowsCustomOptions || form.Options.Count <= QuestionShape.MinObjectiveOptions)
        {
            return;
        }

        form.Options.Remove(option);
        NormalizeOrders();

        if (QuestionShape.RequiresExactlyOneCorrectOption(form.Type) && form.Options.TrueForAll(x => !x.IsCorrect))
        {
            form.Options[0].IsCorrect = true;
        }
    }

    private void MarkSingleCorrect(OptionEditor selected)
    {
        foreach (var option in form.Options)
        {
            option.IsCorrect = ReferenceEquals(option, selected);
        }
    }

    private void NormalizeOrders()
    {
        for (var index = 0; index < form.Options.Count; index++)
        {
            form.Options[index].Order = index + 1;
        }
    }

    private async Task HandleCreateAsync()
    {
        errorMessage = null;
        successMessage = null;
        isBusy = true;

        try
        {
            var result = await CreateQuestion.ExecuteAsync(form.ToRequest());

            form = new QuestionForm();
            ApplyTypeDefaults();
            successMessage = $"Question created with id {result.QuestionId}.";
        }
        catch (Exception exception) when (exception is UseCaseValidationException or EntityNotFoundException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed record SelectOption(Guid Id, string Name);

    private sealed class OptionEditor(string text, bool isCorrect, int order)
    {
        public string Text { get; set; } = text;
        public bool IsCorrect { get; set; } = isCorrect;
        public int Order { get; set; } = order;
    }

    private sealed class QuestionForm : IValidatableObject
    {
        [Required(ErrorMessage = "Statement is required.")]
        [TrimmedStringLength(QuestionShape.MaxStatementLength, ErrorMessage = "Statement is too long.")]
        public string Statement { get; set; } = string.Empty;

        [Required(ErrorMessage = "Subject is required.")]
        public Guid? SubjectId { get; set; }

        [Required(ErrorMessage = "Grade is required.")]
        public Guid? GradeId { get; set; }

        [EnumDataType(typeof(QuestionType), ErrorMessage = "Question type is invalid.")]
        public QuestionType Type { get; set; } = QuestionType.SingleChoice;

        public List<OptionEditor> Options { get; set; } = [];

        public CreateQuestionRequest ToRequest()
        {
            if (SubjectId is not Guid subjectId || GradeId is not Guid gradeId)
            {
                throw new InvalidOperationException("The question form has not passed validation.");
            }

            return new CreateQuestionRequest(
                Statement,
                subjectId,
                gradeId,
                Type,
                [.. Options.Select(x => new CreateQuestionOptionRequest(x.Text, x.IsCorrect, x.Order))]);
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (SubjectId is null || GradeId is null)
            {
                yield break;
            }

            var request = ToRequest();
            var results = new List<ValidationResult>();
            Validator.TryValidateObject(
                request,
                new ValidationContext(request),
                results,
                validateAllProperties: true);

            foreach (var result in results)
            {
                yield return new ValidationResult(result.ErrorMessage, [nameof(Options)]);
            }
        }
    }
}
