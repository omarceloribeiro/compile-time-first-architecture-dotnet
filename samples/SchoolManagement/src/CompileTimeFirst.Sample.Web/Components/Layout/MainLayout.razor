@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span>Compile-Time First School</span>
            <TenantSelector />
        </div>

        <article class="content px-4">
            @* Expected rejections are caught by the screen and shown inline. Anything that reaches
               here is a failure, not a rule - it is shown generically instead of leaking its
               message to the user. *@
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">Something went wrong</h5>
                        <p>The operation could not be completed. The error has been logged.</p>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="Recover">
                            Try again
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    private void Recover() => errorBoundary?.Recover();
}
