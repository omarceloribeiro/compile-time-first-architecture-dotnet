@page "/subjects"
@rendermode InteractiveServer
@inject SubjectsViewModel ViewModel

<PageTitle>Subjects</PageTitle>

<h1>Subjects</h1>

@if (ViewModel.SuccessMessage is not null)
{
    <div class="alert alert-success">@ViewModel.SuccessMessage</div>
}

@if (ViewModel.ErrorMessage is not null)
{
    <div class="alert alert-danger">@ViewModel.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Create New Subject</h5>
        <EditForm Model="ViewModel" OnValidSubmit="HandleCreateAsync">
            <div class="mb-3">
                <label for="subjectName" class="form-label">Name</label>
                <InputText id="subjectName" class="form-control" @bind-Value="ViewModel.NewName" disabled="@ViewModel.IsBusy" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@ViewModel.IsBusy">
                @if (ViewModel.IsBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Create
            </button>
        </EditForm>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Active Subjects (@ViewModel.TotalCount)</h5>
        @if (ViewModel.Items.Count == 0)
        {
            <p class="text-muted">No subjects found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewModel.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td><small class="text-muted">@item.Id</small></td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav class="d-flex justify-content-between align-items-center" aria-label="Subjects pages">
                <button class="btn btn-outline-secondary" disabled="@(!ViewModel.HasPreviousPage)"
                        @onclick="LoadPreviousPageAsync">
                    Previous
                </button>
                <span>Page @(ViewModel.CurrentPage + 1) of @ViewModel.TotalPages</span>
                <button class="btn btn-outline-secondary" disabled="@(!ViewModel.HasNextPage)"
                        @onclick="LoadNextPageAsync">
                    Next
                </button>
            </nav>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync();
    }

    private async Task HandleCreateAsync()
    {
        await ViewModel.CreateAsync();
    }

    private Task LoadPreviousPageAsync() => ViewModel.LoadAsync(ViewModel.CurrentPage - 1);

    private Task LoadNextPageAsync() => ViewModel.LoadAsync(ViewModel.CurrentPage + 1);
}
