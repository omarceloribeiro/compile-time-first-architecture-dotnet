@page "/grades"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CompileTimeFirst.Sample.Application
@using CompileTimeFirst.Sample.Application.Grades
@using CompileTimeFirst.Sample.ReadModel
@inject IReadSchoolDbFactory ReadDbFactory
@inject IReadQueryExecutor QueryExecutor
@inject ICreateGradeUseCase CreateGrade

<PageTitle>Grades</PageTitle>

<h1>Grades</h1>

@if (successMessage is not null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Create New Grade</h5>
        <EditForm Model="form" OnValidSubmit="HandleCreateAsync">
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label for="gradeName" class="form-label">Name</label>
                    <InputText id="gradeName" class="form-control" @bind-Value="form.Name" disabled="@isBusy" />
                    <ValidationMessage For="@(() => form.Name)" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="gradeOrder" class="form-label">Order</label>
                    <InputNumber id="gradeOrder" class="form-control" @bind-Value="form.Order" disabled="@isBusy" />
                    <ValidationMessage For="@(() => form.Order)" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@isBusy">
                @if (isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Create
            </button>
        </EditForm>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Active Grades (@totalCount)</h5>
        @if (items.Count == 0)
        {
            <p class="text-muted">No grades found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Name</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td><strong>@item.Order</strong></td>
                            <td>@item.Name</td>
                            <td><small class="text-muted">@item.Id</small></td>
                        </tr>
                    }
                </tbody>
            </table>

            <PaginationNav CurrentPage="currentPage" TotalCount="totalCount" PageSize="PageSize"
                           OnPageRequested="LoadPageAsync" Label="Grades pages" />
        }
    </div>
</div>

@code {
    private const int PageSize = 10;

    private IReadOnlyList<GradeReadItem> items = [];
    private GradeForm form = new();
    private int currentPage;
    private int totalCount;
    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // EventCallback<int> cannot bind to a method group with optional parameters.
    private Task LoadPageAsync(int page) => LoadAsync(page);

    private async Task LoadAsync(int page = 0, CancellationToken cancellationToken = default)
    {
        page = Math.Max(0, page);

        await using var db = await ReadDbFactory.CreateAsync(cancellationToken);
        var result = await QueryExecutor.ToPageAsync(
            db.Grades
                .Where(x => x.IsActive)
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Id),
            page * PageSize,
            PageSize,
            cancellationToken);

        items = result.Items;
        totalCount = result.TotalCount;
        currentPage = page;
    }

    private async Task HandleCreateAsync()
    {
        errorMessage = null;
        successMessage = null;
        isBusy = true;

        try
        {
            var result = await CreateGrade.ExecuteAsync(
                new CreateGradeRequest(form.Name, form.Order));

            form = new GradeForm();
            successMessage = $"Grade created with id {result.GradeId}.";
            await LoadAsync(currentPage);
        }
        catch (Exception exception) when (exception is UseCaseValidationException or EntityNotFoundException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class GradeForm
    {
        [Required(ErrorMessage = "Grade name is required.")]
        [StringLength(200, ErrorMessage = "Grade name must contain at most 200 characters.")]
        public string Name { get; set; } = string.Empty;

        [Range(1, 100, ErrorMessage = "Grade order must be between 1 and 100.")]
        public int Order { get; set; } = 1;
    }
}
